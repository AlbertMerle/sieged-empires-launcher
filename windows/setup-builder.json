{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.siegedempires.launcher",
  "productName": "Sieged Empires",
  "extraMetadata": {
    "name": "sieged-empires",
    "productName": "Sieged Empires",
    "main": "app/src/main.js",
    "homepage": "https://siegedempires.com",
    "author": {
      "name": "Sieged Empires",
      "email": "siegedempires@users.noreply.github.com"
    }
  },
  "directories": {
    "output": "windows/WindowsSetup",
    "buildResources": "assets"
  },
  "files": [
    "app/**/*",
    "lib/*.js",
    "assets/icon.png",
    "assets/icon-transparent.png",
    "assets/icon.ico",
    "package.json"
  ],
  "extraResources": [
    { "from": "pack-payload", "to": "pack" },
    { "from": "windows/files/manifest.json", "to": "files/manifest.json" },
    { "from": "files/mods", "to": "files/mods" },
    { "from": "files/resourcepacks", "to": "files/resourcepacks" },
    { "from": "assets/icon-transparent.png", "to": "assets/icon-transparent.png" },
    { "from": "assets/icon-transparent.png", "to": "assets/icon.png" },
    { "from": "assets/icon.ico", "to": "assets/icon.ico" }
  ],
  "win": {
    "target": ["msi"],
    "icon": "assets/icon.ico",
    "executableName": "Sieged Empires",
    "artifactName": "Sieged-Empires-${version}-Windows.${ext}",
    "verifyUpdateCodeSignature": false
  },
  "msi": {
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Sieged Empires",
    "perMachine": false,
    "warningsAsErrors": false,
    "runAfterFinish": true
  }
}
