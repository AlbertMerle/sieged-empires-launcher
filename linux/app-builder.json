{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.siegedempires.launcher",
  "productName": "Sieged Empires",
  "extraMetadata": {
    "main": "app/src/main.js"
  },
  "directories": {
    "output": "linux/dist/app",
    "buildResources": "assets"
  },
  "files": [
    "app/src/**/*",
    "app/ui/**/*",
    "app/assets/**/*",
    "app/config.json",
    "package.json",
    "node_modules/minecraft-launcher-core/**/*",
    "node_modules/msmc/**/*"
  ],
  "linux": {
    "target": ["dir"],
    "category": "Game",
    "icon": "assets/icon-transparent.png",
    "executableName": "sieged-empires"
  }
}
